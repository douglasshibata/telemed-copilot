# Telemed-Copilot Environment Variables

# PostgreSQL
POSTGRES_DB=telemed_db
POSTGRES_USER=telemed_user
POSTGRES_PASSWORD=telemed_pass
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO (S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=telemed-audio

# Jitsi Meet
JITSI_APP_ID=telemed-copilot
JITSI_APP_SECRET=telemed_jwt_secret_key_32bytes_long!!
JITSI_DOMAIN=meet.jit.si
